# ==========================================
# Clipit.ai — Environment Configuration
# ==========================================
# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.
# ==========================================

# ==========================================
# Application
# ==========================================
APP_NAME=Clipit.ai
APP_ENV=development
LOG_LEVEL=INFO

# ==========================================
# Backend (FastAPI)
# ==========================================
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# ==========================================
# Database (SQLite)
# ==========================================
DATABASE_PATH=data/clipit.db

# ==========================================
# AI — Ollama (Local LLM)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ==========================================
# AI — Whisper (Transcription)
# ==========================================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Options: base, small, medium, large
# Options: cpu, cuda (if GPU available)

# ==========================================
# Media Processing — FFmpeg
# ==========================================
FFMPEG_PATH=ffmpeg
# Leave as "ffmpeg" if FFmpeg is on your system PATH
# Otherwise provide full path: C:\tools\ffmpeg\bin\ffmpeg.exe

# ==========================================
# Storage
# ==========================================
MEDIA_ROOT=media
UPLOAD_MAX_SIZE_MB=5000

# ==========================================
# Clip Generation
# ==========================================
CLIP_WIDTH=1080
CLIP_HEIGHT=1920
CLIP_FORMAT=mp4
CLIP_CRF=23
