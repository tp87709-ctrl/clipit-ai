# ==========================================
# Clipit.ai — .gitignore
# ==========================================

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
.env/

# Python testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# ==========================================
# Node.js / Frontend
# ==========================================
node_modules/
.next/
out/
.nuxt/
.env.development.local
.env.test.local
.env.production.local

# Frontend build
frontend/.next/
frontend/out/

# ==========================================
# IDE / Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
desktop.ini

# ==========================================
# Environment / Secrets
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# SQLite / Database
# ==========================================
*.db
*.db-journal
*.db-wal
*.db-shm

# ==========================================
# Media / Runtime Files
# ==========================================
# Ignore CONTENTS of media subdirs but keep dirs + .gitkeep tracked
media/uploads/*
media/audio/*
media/clips/*
media/captions/*
media/exports/*
media/cache/*

# Keep directory structure and .gitkeep files tracked
!media/
!media/uploads/
!media/audio/
!media/clips/
!media/captions/
!media/exports/
!media/cache/
!media/uploads/.gitkeep
!media/audio/.gitkeep
!media/clips/.gitkeep
!media/captions/.gitkeep
!media/exports/.gitkeep

# ==========================================
# OS Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Logs
# ==========================================
*.log
logs/

# ==========================================
# Misc
# ==========================================
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/

# Test uploads (E2E test artifacts)
backend/media/

